{
  "name": "bearai-todoai",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "smoke:electron": "electron . --smoke",
    "build": "vue-tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "cn.bearai.todo",
    "productName": "熊智ToDo",
    "artifactName": "熊智ToDo-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "熊智ToDo",
      "deleteAppDataOnUninstall": false
    }
  },
  "main": "dist-electron/electron/main.js",
  "dependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/vue": "^7.22.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^13.6.0",
    "gray-matter": "^4.0.3",
    "vue": "^3.5.18",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "wait-on": "^8.0.4"
  }
}
